# MongoDB connection string
# Local replica set: mongodb://127.0.0.1:27017/kabachok?replicaSet=rs0
# Or MongoDB Atlas M0: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/kabachok?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kabachok?replicaSet=rs0

# Better Auth
BETTER_AUTH_SECRET=super_secret_better_auth_token_at_least_32_characters_long
BETTER_AUTH_URL=http://localhost:3000

# Payment Mock Provider Webhook Secret
PAYMENT_WEBHOOK_SECRET=payment_webhook_secret_for_hmac_sha256
